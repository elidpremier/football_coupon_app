# --- Fournisseurs de données (tous optionnels : sans clé, l'app tourne en MODE DÉMO) ---
# API-Football (offre gratuite : 100 requêtes/jour — le budget logiciel est 85)
API_FOOTBALL_KEY=
# football-data.org (offre gratuite : 10 appels/minute)
FOOTBALL_DATA_TOKEN=

# --- IA (optionnelle, mode par défaut : off = gabarits déterministes) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Telegram (obligatoires uniquement pour publier en réel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHANNEL_ID=
# TELEGRAM_PROD_CHANNEL_ID=

# --- Local ---
# Chemin de la base SQLite (défaut : data/football.db)
DB_PATH=data/football.db
# Répertoire de sortie des publications en mode sec (défaut : data/outbox)
OUTBOX_DIR=data/outbox
# Fuseau de l'application (défaut : Africa/Ouagadougou)
TZ_DISPLAY=Africa/Ouagadougou
